# ==== SERVER ====
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ==== DATABASE ====
MONGO_URI=mongodb://127.0.0.1:27017/petguardian

# ==== JWT ====
# REQUIRED: generate strong random values before deploying:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_STRONG_RANDOM_SECRET
JWT_REFRESH_EXPIRES_IN=30d

# ==== GOOGLE OAUTH ====
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ==== CLOUDINARY ====
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==== EMAIL (SMTP) ====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=ResQPet <no-reply@resqpet.app>

# ==== FIREBASE (PUSH NOTIFICATIONS) ====
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_client_email
FIREBASE_PRIVATE_KEY=your_private_key

# ==== MAPS ====
# Not used - the frontend renders maps with Leaflet + OpenStreetMap, which
# needs no API key. This entry is intentionally left out.

# ==== MQTT (IOT) ====
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=petguardian
MQTT_PASSWORD=change_this_mqtt_password
MQTT_TOPIC_GPS=petguardian/+/gps
MQTT_TOPIC_HEALTH=petguardian/+/health
MQTT_TOPIC_EMERGENCY=petguardian/+/emergency

# ==== PAYMENTS (STRIPE) ====
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ==== IOT DEVICE AUTH ====
# Legacy shared key — still accepted as a fallback for test setups.
# Production devices use per-device tokens generated via:
#   POST /api/admin/iot/provision   (admin JWT required)
# or via the Pet Owner dashboard:
#   POST /api/iot/devices/register  (owner JWT required)
IOT_DEVICE_KEY=change_this_device_shared_secret

# ==== RATE LIMITING ====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
